rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MEMBER_CATEGORIES_V1: descriptive membership, never an automatic grant.
    function memberCategoryActive_() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(p) && get(p).data.uid == request.auth.uid &&
        get(p).data.active == true && get(p).data.access == true;
    }
    function memberCategoryAdmin_() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return memberCategoryActive_() && (p.role == 'administrador_app' ||
        p.get('permissions', {}).get('admin', false) == true || p.get('permissions', {}).get('usersManage', false) == true);
    }
    match /userCategories/{id} {
      allow read: if memberCategoryActive_() && (memberCategoryAdmin_() ||
        (resource.data.uid == request.auth.uid && request.auth.token.get('email_verified', false) == true &&
         resource.data.email == request.auth.token.get('email', '').lower()));
      allow write: if false;
    }
    match /userCategoryDefinitions/{id} {
      allow read: if memberCategoryActive_();
      allow write: if false;
    }
    // END_MEMBER_CATEGORIES_V1

    // YEAR_END_SCHEDULE_V1: private choices, shared anonymous totals; unrelated surveys stay private.
    function yearEndPolicy() {
      return get(/databases/$(database)/documents/yearEndSchedules/2026-2027/policy/participation).data;
    }
    function yearEndCategory() {
      let key = hashing.sha256('"' + request.auth.token.get('email', '').lower() + '"').toHexString().lower();
      return get(/databases/$(database)/documents/userCategories/$(key)).data;
    }
    function yearEndIdentity() {
      let category = yearEndCategory();
      return request.auth != null && request.auth.token.get('email_verified', false) == true &&
        request.auth.token.firebase.get('sign_in_provider', '') == 'google.com' && memberCategoryActive_() &&
        category.schemaVersion == 1 && category.identityStatus == 'LINKED' && category.uid == request.auth.uid &&
        category.email == request.auth.token.get('email', '').lower() && category.memberCategories is list &&
        category.memberCategories.hasAny(['EFETIVO', 'ADMINISTRADOR']) && category.memberCategories.hasOnly(['EFETIVO', 'ADMINISTRADOR', 'GESTOR']) &&
        category.memberCategories.size() == category.memberCategories.toSet().size();
    }
    function yearEndMember() {
      let category = yearEndCategory();
      let policy = yearEndPolicy();
      return yearEndIdentity() && category.memberCategories.hasAll(['EFETIVO']) &&
        policy.schemaVersion == 1 && policy.cycle == '2026-2027' && policy.siglasByUid is map &&
        !policy.get('excludedUids', []).hasAny([request.auth.uid]) &&
        policy.siglasByUid.get(request.auth.uid, '').matches('^([A-Z]{2}|L2)$');
    }
    function yearEndAdmin() {
      return yearEndIdentity() && memberCategoryAdmin_() && !yearEndPolicy().get('excludedUids', []).hasAny([request.auth.uid]);
    }
    function yearEndReader() { return yearEndMember() || yearEndAdmin(); }
    function yearEndWritesReady() { return yearEndPolicy().get('summaryVersion', 0) == 2; }
    function yearEndSigla() {
      return yearEndPolicy().siglasByUid[request.auth.uid];
    }
    function yearEndRecord(d, uid) {
      let sigla = yearEndSigla();
      return d.keys().hasOnly(['uid', 'sigla', 'plantao', 'grupo', 'position', 'createdAt', 'updatedAt']) &&
        d.keys().hasAll(['uid', 'sigla', 'plantao', 'grupo', 'position', 'createdAt', 'updatedAt']) &&
        d.uid == uid && d.sigla == sigla && d.plantao in ['natal', 'reveillon', 'carnaval'] &&
        (sigla in ['FR', 'AD', 'L2', 'LE'] ? d.grupo == null : d.grupo in ['natal', 'reveillon']) &&
        d.position is int && d.position > 0 && d.position <= 9007199254740991 &&
        d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function yearEndCount(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function yearEndTotals(d) {
      return d.keys().hasOnly(['plantaoNatal', 'plantaoReveillon', 'plantaoCarnaval', 'grupoNatal', 'grupoReveillon', 'totalRegistrations', 'updatedAt']) &&
        d.keys().hasAll(['plantaoNatal', 'plantaoReveillon', 'plantaoCarnaval', 'grupoNatal', 'grupoReveillon', 'totalRegistrations', 'updatedAt']) &&
        yearEndCount(d.plantaoNatal) && yearEndCount(d.plantaoReveillon) && yearEndCount(d.plantaoCarnaval) && yearEndCount(d.grupoNatal) && yearEndCount(d.grupoReveillon) && yearEndCount(d.totalRegistrations) &&
        d.plantaoNatal + d.plantaoReveillon + d.plantaoCarnaval == d.totalRegistrations && d.grupoNatal + d.grupoReveillon <= d.totalRegistrations && d.updatedAt == request.time;
    }
    function yearEndDelta(before, after, field, option) {
      return (after.get(field, null) == option ? 1 : 0) - (before.get(field, null) == option ? 1 : 0);
    }
    function yearEndTotalsChange(before, after, previous, next, added) {
      return yearEndTotals(after) && after.totalRegistrations == before.totalRegistrations + added &&
        after.plantaoNatal == before.plantaoNatal + yearEndDelta(previous, next, 'plantao', 'natal') &&
        after.plantaoReveillon == before.plantaoReveillon + yearEndDelta(previous, next, 'plantao', 'reveillon') &&
        after.plantaoCarnaval == before.plantaoCarnaval + yearEndDelta(previous, next, 'plantao', 'carnaval') &&
        after.grupoNatal == before.grupoNatal + yearEndDelta(previous, next, 'grupo', 'natal') &&
        after.grupoReveillon == before.grupoReveillon + yearEndDelta(previous, next, 'grupo', 'reveillon');
    }
    function yearEndPairedTotals(previous, next, added) {
      let path = /databases/$(database)/documents/yearEndSchedules/2026-2027/summary/totals;
      return exists(path) && yearEndTotalsChange(get(path).data, getAfter(path).data, previous, next, added);
    }
    function yearEndPairedRegistration(before, after) {
      let own = /databases/$(database)/documents/yearEndSchedules/2026-2027/registrations/$(request.auth.uid);
      let present = exists(own);
      let previous = present ? get(own).data : {};
      let next = getAfter(own).data;
      return yearEndRecord(next, request.auth.uid) &&
        yearEndTotalsChange(before, after, previous, next, present ? 0 : 1);
    }
    match /users/{uid} {
      allow get: if yearEndReader() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /yearEndSchedules/{cycle}/registrations/{uid} {
      allow get: if cycle == '2026-2027' && (yearEndAdmin() || (yearEndMember() && request.auth.uid == uid));
      allow list: if cycle == '2026-2027' && yearEndAdmin();
      allow create: if cycle == '2026-2027' && yearEndMember() && yearEndWritesReady() && request.auth.uid == uid &&
        yearEndRecord(request.resource.data, uid) &&
        request.resource.data.createdAt == request.time && yearEndPairedTotals({}, request.resource.data, 1) &&
        request.resource.data.position == getAfter(/databases/$(database)/documents/yearEndSchedules/2026-2027/summary/totals).data.totalRegistrations;
      allow update: if cycle == '2026-2027' && yearEndMember() && yearEndWritesReady() && request.auth.uid == uid &&
        yearEndRecord(request.resource.data, uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plantao', 'grupo', 'sigla', 'updatedAt']) &&
        yearEndPairedTotals(resource.data, request.resource.data, 0);
      allow delete: if false;
    }
    match /yearEndSchedules/{cycle}/control/{id} {
      allow get: if cycle == '2026-2027' && id == 'order' && yearEndAdmin();
      allow list, write: if false;
    }
    match /yearEndSchedules/{cycle}/summary/{id} {
      allow get: if cycle == '2026-2027' && id == 'totals' && yearEndReader();
      allow list, create, delete: if false;
      allow update: if cycle == '2026-2027' && id == 'totals' && yearEndMember() && yearEndWritesReady() &&
        yearEndPairedRegistration(resource.data, request.resource.data);
    }
    match /yearEndSchedules/{cycle}/policy/{id} {
      allow get: if cycle == '2026-2027' && id == 'participation' && yearEndAdmin();
      allow list, write: if false;
    }
    match /yearEndSchedules/{cycle}/participation/{uid} {
      allow get: if cycle == '2026-2027' && request.auth.uid == uid && yearEndReader();
      allow list, write: if false;
    }
    // END_YEAR_END_SCHEDULE_V1

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
