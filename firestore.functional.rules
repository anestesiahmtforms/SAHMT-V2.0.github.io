rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedGoogle() {
      return request.auth != null &&
        request.auth.token.firebase is map &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /functionalProfiles/{uid} {
      allow get: if signedGoogle() && request.auth.uid == uid && resource.data.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /functionalRecognition/{uid} {
      allow get: if signedGoogle() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /surveyParticipation/{participationId} {
      allow get: if signedGoogle() && resource.data.uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
