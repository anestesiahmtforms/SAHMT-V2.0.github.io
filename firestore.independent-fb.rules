rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MEMBER_CATEGORIES_V1: descriptive membership, never an automatic grant.
    function memberCategoryActive_() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(p) && get(p).data.uid == request.auth.uid &&
        get(p).data.active == true && get(p).data.access == true;
    }
    function memberCategoryAdmin_() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return memberCategoryActive_() && (p.role == 'administrador_app' ||
        p.get('permissions', {}).get('admin', false) == true || p.get('permissions', {}).get('usersManage', false) == true);
    }
    match /userCategories/{id} {
      allow read: if memberCategoryActive_() && (memberCategoryAdmin_() ||
        (resource.data.uid == request.auth.uid && request.auth.token.get('email_verified', false) == true &&
         resource.data.email == request.auth.token.get('email', '').lower()));
      allow write: if false;
    }
    match /userCategoryDefinitions/{id} {
      allow read: if memberCategoryActive_();
      allow write: if false;
    }
    // END_MEMBER_CATEGORIES_V1

    function fbDomainOpen_(writeOperation) {
      let path = /databases/$(database)/documents/evaluationRuntime/independentFbCutover;
      return exists(path) && get(path).data.status == 'ACTIVE' &&
        get(path).data.release == 'fb-independent-20261022-v1';
    }

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function profile() { return get(profilePath()).data; }
    function activeUser() { return hasProfile() && profile().active == true && profile().access == true; }
    function isAdmin() {
      return activeUser() && ((profile().role == 'administrador_app') ||
        (profile().permissions.keys().hasAny(['admin']) && profile().permissions.admin == true));
    }
    function can(permission) {
      return activeUser() && (isAdmin() ||
        (profile().permissions.keys().hasAny([permission]) && profile().permissions[permission] == true));
    }

    function evaluationOwn(data) { return activeUser() && (isAdmin() || data.uid == request.auth.uid); }


    function evaluationPrivateDetail(data) {
      return activeUser() && (data.uid == request.auth.uid || (isAdmin() &&
        (data.category == 'GOVERNANCE' || (profile().permissions.keys().hasAny(['occurrencesAuditRead']) && profile().permissions.occurrencesAuditRead == true))));
    }
    match /evaluationActivities/{id} {
      function evaluationGroupAccess(group) {
        let accessPath = /databases/$(database)/documents/documentAccessEmails/$(request.auth.token.email.lower());
        return request.auth.token.keys().hasAll(['email', 'email_verified', 'firebase']) && request.auth.token.email is string &&
          request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com' &&
          exists(accessPath) && get(accessPath).data.active == true && get(accessPath).data.email == request.auth.token.email.lower() &&
          get(accessPath).data.groups is list && get(accessPath).data.groups.hasAny([group]);
      }
      function evaluationGroupEligible(data) {
        return data.keys().hasAny(['eligibleGroups']) && data.eligibleGroups is list &&
          ((data.eligibleGroups.hasAny(['GENERAL']) && evaluationGroupAccess('GENERAL')) ||
           (data.eligibleGroups.hasAny(['RESTRICTED']) && evaluationGroupAccess('RESTRICTED')));
      }

      allow read: if fbDomainOpen_(false) && (activeUser() && (isAdmin() ||
        (resource.data.keys().hasAny(['eligibleUids']) && resource.data.eligibleUids is list && resource.data.eligibleUids.hasAny([request.auth.uid])) ||
        (resource.data.keys().hasAny(['managerUid']) && resource.data.managerUid == request.auth.uid) ||
        evaluationGroupEligible(resource.data)));
      allow write: if fbDomainOpen_(true) && (false);
    }
    match /evaluationAwards/{id} { allow read: if fbDomainOpen_(false) && (evaluationPrivateDetail(resource.data)); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationLedger/{id} { allow read: if fbDomainOpen_(false) && (evaluationPrivateDetail(resource.data)); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationSummaries/{uid} { allow read: if fbDomainOpen_(false) && (activeUser() && (request.auth.uid == uid || isAdmin())); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationReference/{id} { allow read: if fbDomainOpen_(false) && (activeUser() && id == 'team'); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationAssignments/{id} { allow read: if fbDomainOpen_(false) && (evaluationOwn(resource.data)); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationAssignmentHistory/{id} { allow read: if fbDomainOpen_(false) && (activeUser() && isAdmin()); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationGovernanceRevisions/{id} { allow read: if fbDomainOpen_(false) && (evaluationOwn(resource.data)); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationParticipations/{id} { allow read: if fbDomainOpen_(false) && (evaluationOwn(resource.data) || (activeUser() && (resource.data.managerUid == request.auth.uid || can('managementManage') || (can('qualityManage') && resource.data.areaIds.hasAny(['area-gestao-da-qualidade']))))); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationTrainingAttempts/{id} { allow read: if fbDomainOpen_(false) && evaluationOwn(resource.data); allow write: if false; }
    match /evaluationLinks/{id} { allow read: if fbDomainOpen_(false) && (isAdmin()); allow write: if fbDomainOpen_(true) && (false); }
    match /evaluationRequests/{id} {
      function evaluationId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,200}$'); }
      function evaluationText(value, minimum, maximum) { return value is string && value.size() >= minimum && value.size() <= maximum; }
      function evaluationHttpsAt(values, index) { return values.size() <= index || (values[index] is string && values[index].size() <= 1500 && values[index].matches('^https://[^/@: ]+[/].*')); }
      function evaluationEvidence(values) {
        return values is list && values.size() <= 10 && evaluationHttpsAt(values, 0) && evaluationHttpsAt(values, 1) &&
          evaluationHttpsAt(values, 2) && evaluationHttpsAt(values, 3) && evaluationHttpsAt(values, 4) && evaluationHttpsAt(values, 5) &&
          evaluationHttpsAt(values, 6) && evaluationHttpsAt(values, 7) && evaluationHttpsAt(values, 8) && evaluationHttpsAt(values, 9);
      }
      function evaluationConfiguration(p) {
        return p.keys().hasAll(['activityId', 'creditScopeId', 'version', 'modalities', 'acknowledgementItemId', 'suggestionProblemItemId', 'suggestionProposalItemId', 'suggestionBenefitItemId', 'validFrom', 'validUntil', 'eligibleUids', 'managerAreaId', 'expectedVersion']) &&
          p.keys().hasOnly(['activityId', 'creditScopeId', 'version', 'modalities', 'acknowledgementItemId', 'suggestionProblemItemId', 'suggestionProposalItemId', 'suggestionBenefitItemId', 'validFrom', 'validUntil', 'eligibleUids', 'eligibleGroups', 'managerAreaId', 'expectedVersion', 'acknowledgementValue', 'materialUrls']) &&
          evaluationId(p.activityId) && evaluationId(p.creditScopeId) && evaluationId(p.managerAreaId) &&
          p.version is int && p.version > 0 && p.expectedVersion is int && p.expectedVersion >= 0 &&
          p.modalities is map && p.modalities.keys().hasAll(['acknowledgement', 'suggestion', 'test']) && p.modalities.keys().hasOnly(['acknowledgement', 'suggestion', 'test']) &&
          p.modalities.acknowledgement is bool && p.modalities.suggestion is bool && p.modalities.test is bool &&
          (p.modalities.acknowledgement || p.modalities.suggestion || p.modalities.test) &&
          evaluationText(p.acknowledgementItemId, 0, 200) && evaluationText(p.suggestionProblemItemId, 0, 200) && evaluationText(p.suggestionProposalItemId, 0, 200) && evaluationText(p.suggestionBenefitItemId, 0, 200) &&
          p.validFrom is string && p.validFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && p.validUntil is string && p.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && p.validFrom <= p.validUntil &&
          p.eligibleUids is list && p.eligibleUids.size() <= 500 &&
          (!p.keys().hasAny(['eligibleGroups']) || (p.eligibleGroups is list && p.eligibleGroups.size() <= 2 && p.eligibleGroups.toSet().size() == p.eligibleGroups.size() && p.eligibleGroups.hasOnly(['GENERAL', 'RESTRICTED']))) &&
          (p.eligibleUids.size() > 0 || (p.keys().hasAny(['eligibleGroups']) && p.eligibleGroups.size() > 0)) &&
          (!p.keys().hasAny(['acknowledgementValue']) || evaluationText(p.acknowledgementValue, 1, 200)) &&
          (!p.keys().hasAny(['materialUrls']) || evaluationEvidence(p.materialUrls));
      }
      function evaluationGovernanceRequest(p) {
        let assignmentPath = /databases/$(database)/documents/evaluationAssignments/$(p.areaId);
        return p.keys().hasAll(['activityId', 'areaId', 'assignmentId', 'previousVersion', 'newVersion', 'summary', 'components', 'materialEvidence', 'questionEvidence']) &&
          p.keys().hasOnly(['activityId', 'areaId', 'assignmentId', 'previousVersion', 'newVersion', 'summary', 'components', 'materialEvidence', 'questionEvidence']) &&
          evaluationId(p.activityId) && evaluationId(p.areaId) && evaluationId(p.assignmentId) &&
          exists(assignmentPath) && get(assignmentPath).data.uid == request.auth.uid &&
          p.previousVersion is int && p.previousVersion >= 0 && p.newVersion is int && p.newVersion > p.previousVersion &&
          evaluationText(p.summary, 8, 2000) && p.components is list && p.components.size() >= 1 && p.components.size() <= 2 && p.components.toSet().size() == p.components.size() && p.components.hasOnly(['MATERIAL', 'QUESTIONS']) &&
          evaluationEvidence(p.materialEvidence) && evaluationEvidence(p.questionEvidence) &&
          (!p.components.hasAny(['MATERIAL']) || p.materialEvidence.size() > 0) && (!p.components.hasAny(['QUESTIONS']) || p.questionEvidence.size() > 0);
      }
      function evaluationSuggestionReview(p) {
        let path = /databases/$(database)/documents/evaluationParticipations/$(p.participationId);
        let authorizedReviewer = isAdmin() || can('managementManage') ||
          (can('qualityManage') && get(path).data.areaIds.hasAny(['area-gestao-da-qualidade'])) ||
          get(path).data.managerUid == request.auth.uid;
        return p.keys().hasAll(['participationId', 'decision', 'note']) && p.keys().hasOnly(['participationId', 'decision', 'note']) &&
          evaluationId(p.participationId) && p.decision in ['APPROVE', 'REJECT'] && evaluationText(p.note, 8, 1000) &&
          exists(path) && get(path).data.uid != request.auth.uid && authorizedReviewer;
      }
      function evaluationGovernanceReview(p) {
        let path = /databases/$(database)/documents/evaluationGovernanceRevisions/$(p.revisionId);
        return isAdmin() && p.keys().hasAll(['revisionId', 'decision', 'note']) && p.keys().hasOnly(['revisionId', 'decision', 'note']) &&
          evaluationId(p.revisionId) && p.decision in ['APPROVE', 'REJECT'] && evaluationText(p.note, 8, 1000) && exists(path) && get(path).data.uid != request.auth.uid;
      }
      function evaluationCorrection(p) {
        let path = /databases/$(database)/documents/evaluationAwards/$(p.awardId);
        return isAdmin() && p.keys().hasAll(['awardId', 'category', 'expectedAwardVersion', 'correctedPoints', 'reason']) &&
          p.keys().hasOnly(['awardId', 'category', 'expectedAwardVersion', 'correctedPoints', 'reason']) && evaluationId(p.awardId) &&
          p.category in ['PERFORMANCE', 'GOVERNANCE'] && exists(path) && evaluationPrivateDetail(get(path).data) && get(path).data.category == p.category &&
          p.expectedAwardVersion is int && p.expectedAwardVersion >= 0 && p.correctedPoints is number && p.correctedPoints >= -100000 && p.correctedPoints <= 100000 && evaluationText(p.reason, 8, 1000);
      }
      function validEvaluationRequest(data, id) {
        return activeUser() && request.auth.token.email_verified == true &&
          data.keys().hasAll(['id', 'type', 'actorUid', 'createdAt', 'status', 'payload']) && data.keys().hasOnly(['id', 'type', 'actorUid', 'createdAt', 'status', 'payload']) &&
          data.id == id && evaluationId(id) && data.actorUid == request.auth.uid && data.createdAt == request.time && data.status == 'PENDING' && data.payload is map &&
          ((data.type == 'ASSIGN_MANAGER' && isAdmin() && data.payload.keys().hasAll(['areaId', 'managerUid', 'expectedVersion']) && data.payload.keys().hasOnly(['areaId', 'managerUid', 'expectedVersion']) && evaluationId(data.payload.areaId) && evaluationId(data.payload.managerUid) && data.payload.expectedVersion is int && data.payload.expectedVersion >= 0) ||
           (data.type == 'CONFIGURE_ACTIVITY' && isAdmin() && evaluationConfiguration(data.payload)) ||
           (data.type == 'REQUEST_GOVERNANCE' && evaluationGovernanceRequest(data.payload)) ||
           (data.type == 'REVIEW_SUGGESTION' && evaluationSuggestionReview(data.payload)) ||
           (data.type == 'REVIEW_GOVERNANCE' && evaluationGovernanceReview(data.payload)) ||
           (data.type == 'CORRECT_SCORE' && evaluationCorrection(data.payload)) ||
           (data.type == 'RECONCILE_LINKS' && (isAdmin() || can('documentsManage') || can('managementManage') || can('qualityManage') || can('trainingsManage')) && data.payload.keys().size() == 0));
      }

      allow get: if fbDomainOpen_(false) && (activeUser() && (resource == null || isAdmin() || resource.data.actorUid == request.auth.uid));
      allow list: if fbDomainOpen_(false) && (activeUser() && (isAdmin() || resource.data.actorUid == request.auth.uid));
      allow create: if fbDomainOpen_(true) && (validEvaluationRequest(request.resource.data, id));
      allow update, delete: if fbDomainOpen_(true) && (false);
    }

    function qualityManageArea(areaId) { return can('qualityManage') && areaId == 'area-gestao-da-qualidade'; }
    function assignedDocumentAreaManager(areaId) {
      let path = /databases/$(database)/documents/managementAreas/$(areaId);
      return areaId == 'area-gestao-de-documentos' && can('managementRead') && exists(path) &&
        get(path).data.active == true && get(path).data.managerUids is list &&
        get(path).data.managerUids.hasAny([request.auth.uid]);
    }
    function managementDocumentManage(areaId) {
      return can('documentsManage') || qualityManageArea(areaId) || assignedDocumentAreaManager(areaId);
    }

    function activityAccess(areaId) { return can('managementRead') || can('managementActivityWrite') || qualityManageArea(areaId); }
    function indicatorAccess(areaId) { return can('managementRead') || can('managementIndicatorsRead') || can('managementIndicatorsWrite') || qualityManageArea(areaId); }
    function actionPlanAccess(areaId) { return can('managementRead') || can('managementPlansManage') || qualityManageArea(areaId); }

    function notificationAudienceMatches(data) {
      let areaPath = /databases/$(database)/documents/managementAreas/$(data.audienceValue);
      let groupPath = /databases/$(database)/documents/notificationGroups/$(data.audienceValue);
      return (data.audienceType == 'ALL' && data.audienceValue == '') ||
        (data.audienceType == 'USER' && data.audienceValue == request.auth.uid) ||
        (data.audienceType == 'ROLE' && data.audienceValue == profile().role) ||
        (data.audienceType == 'SIGLA' && data.audienceValue == profile().sigla) ||
        (data.audienceType == 'MANAGEMENT_AREA' && exists(areaPath) && get(areaPath).data.active == true &&
          ((get(areaPath).data.memberUids is list && get(areaPath).data.memberUids.hasAny([request.auth.uid])) ||
           (get(areaPath).data.managerUids is list && get(areaPath).data.managerUids.hasAny([request.auth.uid])))) ||
        (data.audienceType == 'GROUP' && exists(groupPath) && get(groupPath).data.active == true &&
          get(groupPath).data.memberUids is list && get(groupPath).data.memberUids.hasAny([request.auth.uid]));
    }

    function checklistAccess() {
      return can('checklistRead') || can('checklistWrite') || can('checklistSign') || can('checklistManage');
    }
    function validIsoDay(value) {
      return value is string && (
        value.matches('^\\d{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$') ||
        value.matches('^\\d{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$') ||
        value.matches('^\\d{4}-02-(0[1-9]|1[0-9]|2[0-9])$'));
    }

    function paddedDayPart(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }
    function serverSaoPauloDay() {
      let localTime = request.time - duration.value(3, 'h');
      return string(localTime.year()) + '-' + paddedDayPart(localTime.month()) + '-' + paddedDayPart(localTime.day());
    }

    function learningActivityAudience(data) {
      return (data.audienceType == 'ALL' && data.audienceValue == '') ||
        (data.audienceType == 'ROLE' && data.audienceValue == profile().role) ||
        (data.audienceType == 'USER' && data.audienceValue == request.auth.uid);
    }

    function documentVerifiedEmail() {
      return activeUser() && request.auth.token.keys().hasAll(['email', 'email_verified', 'firebase']) &&
        request.auth.token.email_verified == true && request.auth.token.email is string &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function actorIsSelf() { return signedIn() && request.resource.data.createdByUid == request.auth.uid; }
    function updateActorIsSelf() { return signedIn() && request.resource.data.updatedByUid == request.auth.uid; }
    
    
    
    

    function activeManagementArea(areaId) {
      let path = /databases/$(database)/documents/managementAreas/$(areaId);
      return areaId is string && areaId.matches('^[^/]{1,128}$') && exists(path) && get(path).data.active == true;
    }

    function hasActivityActionAfter(activityId, action, actionType) {
      let interactionPath = /databases/$(database)/documents/activityInteractions/$(action + '-' + activityId);
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      return existsAfter(interactionPath) && getAfter(interactionPath).data.id == action + '-' + activityId &&
        getAfter(interactionPath).data.activityId == activityId && getAfter(interactionPath).data.uid == request.auth.uid && getAfter(interactionPath).data.type == actionType &&
        getAfter(interactionPath).data.createdAt == request.time && getAfter(interactionPath).data.evidence == null && getAfter(interactionPath).data.pointsGenerated == 0 &&
        getAfter(interactionPath).data.content is string && getAfter(interactionPath).data.content.size() > 0 && getAfter(interactionPath).data.content.size() <= 1000 &&
        (actionType == 'COMPLETION'
          ? getAfter(interactionPath).data.pointsClaimed is int &&
            (get(activityPath).data.pointsEnabled == true
              ? getAfter(interactionPath).data.pointsStatus == 'PENDING_VALIDATION' && getAfter(interactionPath).data.pointsClaimed == get(activityPath).data.points
              : getAfter(interactionPath).data.pointsStatus == 'NOT_APPLICABLE' && getAfter(interactionPath).data.pointsClaimed == 0)
          : !getAfter(interactionPath).data.keys().hasAny(['pointsStatus', 'pointsClaimed']));
    }



    // BEGIN_TARGETED_APP_UPDATES_V1
    match /users/{uid} {
      function validAppUpdateRequest_() {
        let r = request.resource.data.appUpdateRequest;
        return r == null || (r is map &&
          r.keys().hasAll(['id', 'target', 'minimumRelease', 'requestedByUid', 'requestedAt']) &&
          r.keys().hasOnly(['id', 'target', 'minimumRelease', 'requestedByUid', 'requestedAt']) &&
          r.id is string && r.id.matches('^[a-zA-Z0-9_-]{16,80}$') && r.target == 'FB' &&
          r.minimumRelease is int && r.minimumRelease > 0 && r.minimumRelease <= 9007199254740991 &&
          r.requestedByUid == request.auth.uid && r.requestedAt == request.time);
      }
      allow update: if isAdmin() && request.resource.data.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appUpdateRequest']) &&
        request.resource.data.keys().hasAny(['appUpdateRequest']) && validAppUpdateRequest_();
      match /appInstallations/{installation} {
        function validAppInstallation_() {
          let d = request.resource.data;
          let r = get(/databases/$(database)/documents/users/$(uid)).data.get('appUpdateRequest', null);
          return d.keys().hasAll(['uid', 'deviceId', 'target', 'platform', 'loadedRelease', 'confirmedRequestId', 'lastSeenAt']) &&
            d.keys().hasOnly(['uid', 'deviceId', 'target', 'platform', 'loadedRelease', 'confirmedRequestId', 'lastSeenAt']) &&
            d.uid == uid && d.deviceId is string && d.deviceId.matches('^[a-f0-9-]{36}$') &&
            installation == d.deviceId + '_FB' && d.target == 'FB' &&
            d.platform in ['Android', 'iOS', 'Windows', 'macOS', 'Outro'] &&
            d.loadedRelease is int && d.loadedRelease > 0 && d.loadedRelease <= 9007199254740991 &&
            d.lastSeenAt == request.time && d.confirmedRequestId is string &&
            (d.confirmedRequestId == '' || (r != null && d.confirmedRequestId == r.id && d.loadedRelease >= r.minimumRelease));
        }
        allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
        allow create, update: if activeUser() && request.auth.uid == uid && validAppInstallation_();
        allow delete: if false;
      }
    }
    // END_TARGETED_APP_UPDATES_V1

    match /users/{uid} {
      function validNotificationRead(data, uid, notificationId) {
        let noticePath = /databases/$(database)/documents/notifications/$(notificationId);
        let notice = get(noticePath).data;
        return data.keys().hasAll(['id', 'notificationId', 'uid', 'readAt']) &&
          data.keys().hasOnly(['id', 'notificationId', 'uid', 'readAt']) &&
          data.id == notificationId && data.notificationId == notificationId && data.uid == uid &&
          data.readAt == request.time && exists(noticePath) && notice.active == true && notificationAudienceMatches(notice);
      }
      function validUserProfile(data, uid) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'sigla', 'phone', 'active', 'access', 'role', 'permissions', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['uid', 'email', 'displayName', 'sigla', 'phone', 'active', 'access', 'role', 'permissions', 'createdAt', 'updatedAt', 'appUpdateRequest']) &&
          data.uid == uid && data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
          data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
          data.sigla is string && data.sigla.size() <= 20 && data.phone is string && data.phone.size() <= 40 &&
          data.active is bool && data.access is bool && data.role in ['coordenador', 'conselho_diretor', 'gestor', 'anestesiologista', 'residente', 'temporario', 'administrador_app'] &&
          data.permissions is map && data.permissions.keys().hasOnly(['checklistRead', 'checklistWrite', 'checklistSign', 'checklistManage', 'labelsRead', 'labelsWrite', 'labelsManage', 'eventsRead', 'eventsWrite', 'eventsCatalogManage', 'scheduleRead', 'scheduleWrite', 'trainingsRead', 'trainingsManage', 'managementModuleEnabled', 'performanceModuleEnabled', 'managementRead', 'managementManage', 'managementActivityWrite', 'managementIndicatorsRead', 'managementIndicatorsWrite', 'managementPlansManage', 'documentsManage', 'qualityManage', 'equipmentManage', 'peopleManage', 'financeRead', 'financeWrite', 'financeManage', 'notificationsRead', 'notificationsManage', 'occurrencesRead', 'occurrencesWrite', 'occurrencesAuditRead', 'usersManage', 'admin']) &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }
      function hasUserManagementPrivilege(data) {
        return data.role == 'administrador_app' ||
          (data.permissions.keys().hasAny(['admin']) && data.permissions.admin == true) ||
          (data.permissions.keys().hasAny(['usersManage']) && data.permissions.usersManage == true);
      }
      function mayManageUser(uid) {
        return request.auth.uid != uid && can('usersManage') && validUserProfile(request.resource.data, uid) &&
          (!hasUserManagementPrivilege(request.resource.data) || isAdmin()) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['appUpdateRequest']);
      }

      allow read: if signedIn() && (request.auth.uid == uid || can('usersManage'));
      allow create: if can('usersManage') && validUserProfile(request.resource.data, uid) && !request.resource.data.keys().hasAny(['appUpdateRequest']) &&
        (!hasUserManagementPrivilege(request.resource.data) || isAdmin());
      allow update: if mayManageUser(uid) || (activeUser() && request.auth.uid == uid && request.resource.data.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']));
      allow delete: if false;

      match /notificationReads/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if can('notificationsRead') && request.auth.uid == uid &&
          validNotificationRead(request.resource.data, uid, notificationId);
        allow update, delete: if false;
      }
    }

    match /accessRequests/{uid} {
      function validAccessRequest(data, uid) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt']) &&
          data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt']) &&
          data.uid == uid && data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
          data.email == request.auth.token.email && request.auth.token.email_verified == true &&
          data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
          data.status == 'PENDING' && data.createdAt == request.time;
      }
      function validAccessRequestApproval(uid) {
        let profileAfter = getAfter(/databases/$(database)/documents/users/$(uid)).data;
        return can('usersManage') && resource.data.uid == uid && resource.data.status == 'PENDING' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedByUid', 'resolvedAt']) &&
