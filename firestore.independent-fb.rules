      allow update: if fbDomainOpen_(true) && (managementDocumentManage(resource.data.managementAreaId) && validScopedManagementDocument(request.resource.data, documentId) &&
        request.resource.data.managementAreaId == resource.data.managementAreaId && request.resource.data.publishedAt == resource.data.publishedAt &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'driveFileId', 'driveUrl', 'category', 'active', 'requiredReading', 'audienceGroup', 'updatedByUid', 'updatedAt', 'version']));
      allow delete: if fbDomainOpen_(true) && (false);
    }
    match /equipment/{equipmentId} {
      function validEquipment(data, equipmentId) {
        return data.keys().hasAll(['id', 'tag', 'managementAreaId', 'name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.keys().hasOnly(['id', 'tag', 'managementAreaId', 'name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.id == equipmentId && data.tag == equipmentId && data.tag.matches('^[A-Z0-9_-]{2,40}$') &&
          data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
          data.serialNumber is string && data.serialNumber.size() <= 120 && data.location is string && data.location.size() > 0 && data.location.size() <= 160 &&
          data.responsibleUid is string && data.responsibleUid.size() > 0 && data.responsibleUid.size() <= 128 &&
          data.status in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] && data.active is bool && (data.status != 'RETIRED' || data.active == false) &&
          (data.lastEventId == null || (data.lastEventId is string && data.lastEventId.size() >= 10 && data.lastEventId.size() <= 200)) &&
          (data.lastEventAt == null || data.lastEventAt is timestamp) && data.version is int && data.version >= 1 &&
          data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
          data.updatedByUid == request.auth.uid && data.updatedAt == request.time;
      }
      function validEquipmentUpdate(equipmentId) {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        let eventPath = /databases/$(database)/documents/equipmentEvents/$(data.lastEventId);
        return validEquipment(data, equipmentId) && data.managementAreaId == resource.data.managementAreaId &&
          data.createdByUid == resource.data.createdByUid && data.createdAt == resource.data.createdAt && data.version == resource.data.version + 1 &&
          changed.hasOnly(['name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'updatedByUid', 'updatedAt', 'version']) &&
          (!changed.hasAny(['status', 'lastEventId', 'lastEventAt']) ||
            (data.lastEventId is string && data.lastEventAt == request.time && existsAfter(eventPath) &&
             getAfter(eventPath).data.equipmentId == equipmentId && getAfter(eventPath).data.managementAreaId == data.managementAreaId &&
             getAfter(eventPath).data.fromStatus == resource.data.status && getAfter(eventPath).data.toStatus == data.status &&
             getAfter(eventPath).data.createdAt == request.time));
      }

      allow read: if fbDomainOpen_(false) && (can('equipmentManage'));
      allow create: if fbDomainOpen_(true) && (can('equipmentManage') && validEquipment(request.resource.data, equipmentId) &&
        activeManagementArea(request.resource.data.managementAreaId) && request.resource.data.status == 'OPERATIONAL' &&
        request.resource.data.active == true && request.resource.data.lastEventId == null && request.resource.data.lastEventAt == null &&
        request.resource.data.version == 1 && request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time);
      allow update: if fbDomainOpen_(true) && (can('equipmentManage') && validEquipmentUpdate(equipmentId));
      allow delete: if fbDomainOpen_(true) && (false);
    }
    match /equipmentEvents/{eventId} {
      function validEquipmentEvent(data, eventId) {
        return data.keys().hasAll(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'fromStatus', 'toStatus', 'createdByUid', 'createdAt']) &&
          data.keys().hasOnly(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'fromStatus', 'toStatus', 'createdByUid', 'createdAt']) &&
          data.id == eventId && data.equipmentId is string && data.equipmentId.size() >= 2 && data.equipmentId.size() <= 40 &&
          data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
          data.type in ['INCIDENT', 'STATUS_CHANGE'] && data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
          data.fromStatus in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] && data.toStatus in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] &&
          data.createdByUid == request.auth.uid && data.createdAt == request.time;
      }
      function validEquipmentEventCreate(eventId) {
        let data = request.resource.data;
        let equipmentPath = /databases/$(database)/documents/equipment/$(data.equipmentId);
        let before = get(equipmentPath).data;
        let after = getAfter(equipmentPath).data;
        return can('equipmentManage') && validEquipmentEvent(data, eventId) && exists(equipmentPath) && existsAfter(equipmentPath) &&
          before.active == true && before.managementAreaId == data.managementAreaId && after.lastEventId == eventId &&
          after.lastEventAt == request.time && after.version == before.version + 1 && after.status == data.toStatus &&
          ((data.type == 'STATUS_CHANGE' && data.toStatus != data.fromStatus) || (data.type == 'INCIDENT' && data.toStatus == data.fromStatus));
      }

      allow read: if fbDomainOpen_(false) && (can('equipmentManage'));
      allow create: if fbDomainOpen_(true) && (validEquipmentEventCreate(eventId));
      allow update, delete: if fbDomainOpen_(true) && (false);
    }
    match /maintenanceRecords/{recordId} {
      function validMaintenanceRecord(data, recordId) {
        return data.keys().hasAll(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'responsibleUid', 'dueAt', 'status', 'completedAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.keys().hasOnly(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'responsibleUid', 'dueAt', 'status', 'completedAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.id == recordId && data.equipmentId is string && data.equipmentId.size() >= 2 && data.equipmentId.size() <= 40 &&
          data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
          data.type in ['PREVENTIVE', 'CORRECTIVE', 'CALIBRATION', 'INSPECTION'] && data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
          data.responsibleUid is string && data.responsibleUid.size() > 0 && data.responsibleUid.size() <= 128 && (data.dueAt == null || validIsoDay(data.dueAt)) &&
          data.status in ['OPEN', 'IN_PROGRESS', 'COMPLETED'] && (data.completedAt == null || data.completedAt is timestamp) &&
          data.version is int && data.version >= 1 && data.createdByUid == request.auth.uid && data.createdAt is timestamp &&
          data.updatedByUid == request.auth.uid && data.updatedAt == request.time;
      }
      function validMaintenanceTransition(recordId) {
        let data = request.resource.data;
        return validMaintenanceRecord(data, recordId) && data.equipmentId == resource.data.equipmentId &&
          data.managementAreaId == resource.data.managementAreaId && data.type == resource.data.type &&
          data.description == resource.data.description && data.responsibleUid == resource.data.responsibleUid && data.dueAt == resource.data.dueAt &&
          data.createdByUid == resource.data.createdByUid && data.createdAt == resource.data.createdAt && data.version == resource.data.version + 1 &&
          data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedByUid', 'updatedAt', 'version']) &&
          ((resource.data.status == 'OPEN' && data.status == 'IN_PROGRESS' && data.completedAt == null) ||
           (resource.data.status == 'IN_PROGRESS' && data.status == 'COMPLETED' && data.completedAt == request.time));
      }

      allow read: if fbDomainOpen_(false) && (can('equipmentManage'));
      allow create: if fbDomainOpen_(true) && (can('equipmentManage') && validMaintenanceRecord(request.resource.data, recordId) &&
        request.resource.data.status == 'OPEN' && request.resource.data.completedAt == null && request.resource.data.version == 1 &&
        request.resource.data.createdAt == request.time && request.resource.data.equipmentId is string &&
        exists(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)) &&
        get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.active == true &&
        request.resource.data.managementAreaId == get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.managementAreaId);
      allow update: if fbDomainOpen_(true) && (can('equipmentManage') && validMaintenanceTransition(recordId));
      allow delete: if fbDomainOpen_(true) && (false);
    }
    match /notifications/{notificationId} {
      function validNotification(data, notificationId) {
        return data.keys().hasAll(['id', 'title', 'message', 'type', 'audienceType', 'audienceValue', 'createdAt', 'createdByUid', 'updatedByUid', 'updatedAt', 'startAt', 'endAt', 'active', 'priority', 'actionRoute', 'version']) &&
          data.keys().hasOnly(['id', 'title', 'message', 'type', 'audienceType', 'audienceValue', 'createdAt', 'createdByUid', 'updatedByUid', 'updatedAt', 'startAt', 'endAt', 'active', 'priority', 'actionRoute', 'version']) &&
          data.id == notificationId && data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
          data.message is string && data.message.size() > 0 && data.message.size() <= 1200 && data.type is string && data.type.size() > 0 && data.type.size() <= 40 &&
          data.audienceType in ['ALL', 'ROLE', 'USER', 'SIGLA', 'MANAGEMENT_AREA', 'GROUP'] && data.audienceValue is string && data.audienceValue.size() <= 128 &&
          ((data.audienceType == 'ALL' && data.audienceValue == '') ||
           (data.audienceType == 'ROLE' && data.audienceValue in ['coordenador', 'conselho_diretor', 'gestor', 'anestesiologista', 'residente', 'temporario', 'administrador_app']) ||
           (data.audienceType == 'USER' && data.audienceValue.size() > 0) ||
           (data.audienceType == 'SIGLA' && (data.audienceValue.matches('^[A-Z]{2}$') || data.audienceValue == 'L2')) ||
           (data.audienceType == 'MANAGEMENT_AREA' && activeManagementArea(data.audienceValue)) ||
           (data.audienceType == 'GROUP' && exists(/databases/$(database)/documents/notificationGroups/$(data.audienceValue)) && get(/databases/$(database)/documents/notificationGroups/$(data.audienceValue)).data.active == true)) &&
          data.createdAt is timestamp && data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid && data.updatedAt is timestamp &&
          data.startAt is timestamp && data.endAt is timestamp && data.endAt >= data.startAt && data.active is bool &&
          data.priority is int && data.priority >= 0 && data.priority <= 5 && data.actionRoute in ['', 'home', 'events', 'labels', 'management', 'checklist', 'training', 'people', 'admin'] &&
          data.version is int && data.version > 0;
      }

      allow read: if can('notificationsManage') || (can('notificationsRead') && resource.data.active == true && notificationAudienceMatches(resource.data));
      allow create: if ((request.resource.data.audienceType != 'MANAGEMENT_AREA') || fbDomainOpen_(true)) && can('notificationsManage') && validNotification(request.resource.data, notificationId) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if ((request.resource.data.audienceType != 'MANAGEMENT_AREA' && resource.data.audienceType != 'MANAGEMENT_AREA') || fbDomainOpen_(true)) && can('notificationsManage') && validNotification(request.resource.data, notificationId) && updateActorIsSelf() &&
        request.resource.data.createdByUid == resource.data.createdByUid && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time && request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'message', 'type', 'audienceType', 'audienceValue', 'updatedByUid', 'updatedAt', 'startAt', 'endAt', 'active', 'priority', 'actionRoute', 'version']);
      allow delete: if false;
    }
    match /notificationGroups/{groupId} {
      function validNotificationGroup(data, groupId) {
        return data.keys().hasAll(['id', 'name', 'memberUids', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.keys().hasOnly(['id', 'name', 'memberUids', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
          data.id == groupId && data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
          data.memberUids is list && data.memberUids.size() <= 500 && data.active is bool &&
          data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      allow read: if can('notificationsManage') || (can('notificationsRead') && resource.data.active == true && resource.data.memberUids is list && resource.data.memberUids.hasAny([request.auth.uid]));
      allow create: if can('notificationsManage') && validNotificationGroup(request.resource.data, groupId);
      allow update: if can('notificationsManage') && validNotificationGroup(request.resource.data, groupId) &&
        request.resource.data.createdByUid == resource.data.createdByUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /auditLogs/{auditId} {
      allow read: if can('admin');
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
    // BEGIN OCCURRENCES_FA_V1

    // END OCCURRENCES_FA_V1

// BEGIN QMENTUM_FA















// END QMENTUM_FA

  }
