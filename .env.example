# Chave pública reCAPTCHA v3 para App Check. Configure após cadastrar o domínio Pages no Firebase.
# Deixe vazio para não enviar tokens App Check. App Check enforcement é ativado separadamente no Console.
VITE_APP_CHECK_SITE_KEY=
# Endpoint público do Cloudflare Worker; nunca inclua uma chave de API neste arquivo.
VITE_LABEL_AI_ENDPOINT=https://sahmt-label-ai.anestesiahmtforms.workers.dev/v1/labels/extract
# Mantenha false até App Check, Worker e homologação institucional serem conferidos.
VITE_LABEL_AI_ENABLED=false

# O cliente de produção utiliza somente FA. Não configurar apps Web FB/FC aqui.
VITE_EVALUATION_DATA_PROJECT=FA
VITE_MANAGEMENT_DATA_PROJECT=FA
VITE_OCCURRENCE_SCORING_ENABLED=false
# Nome legado: esta origem ainda autentica a entrega de pontuação de Ocorrências
# ao Worker FA; não habilita sessões FB/FC. Preservar até migração específica.
VITE_FIREBASE_PROJECT_AUTH_ALLOWED_ORIGIN=

# First login for pre-enrolled FA users without a linked Google provider.
# Leave disabled until FA profiles have approved firstLoginCohort values and
# the operational Worker/Gateway configuration has been separately authorized.
VITE_MANAGEMENT_FA_FIRST_LOGIN_ENABLED=false
VITE_MANAGEMENT_FA_FIRST_LOGIN_ENDPOINT=
VITE_MANAGEMENT_FA_GOOGLE_CLIENT_ID=

# Interface administrativa local para classificação de primeiro login no FA.
# Mantenha false; isso não ativa o fluxo de autenticação especial.
VITE_MANAGEMENT_FIRST_LOGIN_COHORT_ADMIN_ENABLED=false

# Envio por registro para a planilha; vazio mantém desativado. Nunca inserir segredo HMAC aqui.
VITE_OPERATIONAL_SHEETS_ENDPOINT=

# Leitura de Diretrizes e liberação individual: desligado até homologação.
# Endpoint público do Worker; nenhuma chave HMAC ou identidade deve ir ao frontend.
VITE_DIRETRIZES_READING_ENABLED=false
VITE_DIRETRIZES_READING_ENDPOINT=
