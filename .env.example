# Chave pública reCAPTCHA v3 para App Check. Configure após cadastrar o domínio Pages no Firebase.
# Deixe vazio para não enviar tokens App Check. App Check enforcement é ativado separadamente no Console.
VITE_APP_CHECK_SITE_KEY=
# Endpoint público do Cloudflare Worker; nunca inclua uma chave de API neste arquivo.
VITE_LABEL_AI_ENDPOINT=https://sahmt-label-ai.anestesiahmtforms.workers.dev/v1/labels/extract
# Mantenha false até App Check, Worker e homologação institucional serem conferidos.
VITE_LABEL_AI_ENABLED=false

# FB (Gestão): configuração Web pública do app registrado no projeto Firebase.
VITE_MANAGEMENT_FIREBASE_API_KEY=
VITE_MANAGEMENT_FIREBASE_AUTH_DOMAIN=sahmt-gestao-5ae66.firebaseapp.com
VITE_MANAGEMENT_FIREBASE_PROJECT_ID=sahmt-gestao-5ae66
VITE_MANAGEMENT_FIREBASE_STORAGE_BUCKET=
VITE_MANAGEMENT_FIREBASE_MESSAGING_SENDER_ID=613953519880
VITE_MANAGEMENT_FIREBASE_APP_ID=
VITE_MANAGEMENT_FIREBASE_ENABLED=false
# Switch only together with the trusted evaluation producer and FB rules/data.
# FB is exclusive after cutover: there is no automatic fallback to FA.
VITE_EVALUATION_DATA_PROJECT=FA
VITE_OCCURRENCE_SCORING_ENABLED=false

# FC (Indicadores): configuração Web pública do app registrado no projeto Firebase.
# Os valores são configuração pública do app; o objeto real fica no .env.local ignorado.
VITE_INDICATORS_FIREBASE_API_KEY=
VITE_INDICATORS_FIREBASE_AUTH_DOMAIN=indicadores---sahmt.firebaseapp.com
VITE_INDICATORS_FIREBASE_PROJECT_ID=indicadores---sahmt
VITE_INDICATORS_FIREBASE_STORAGE_BUCKET=
VITE_INDICATORS_FIREBASE_MESSAGING_SENDER_ID=
VITE_INDICATORS_FIREBASE_APP_ID=
# A sessão FC permanece desligada até o broker emitir token próprio e passar homologação.
VITE_INDICATORS_FIREBASE_ENABLED=false

# Broker exclusivo de autenticação FB + FC. Não reutilize o Worker de Etiquetas.
# Mantenha desligado até homologação e autorização de produção.
VITE_FIREBASE_PROJECT_AUTH_ENABLED=false
VITE_FIREBASE_PROJECT_AUTH_ENDPOINT=
VITE_FIREBASE_PROJECT_AUTH_ALLOWED_ORIGIN=
VITE_FIREBASE_PROJECT_AUTH_AUTO_CONNECT_ENABLED=false

# First login for pre-enrolled FA users without a linked Google provider.
# Leave disabled until FA profiles have approved firstLoginCohort values and
# the operational Worker/Gateway configuration has been separately authorized.
VITE_MANAGEMENT_FA_FIRST_LOGIN_ENABLED=false
VITE_MANAGEMENT_FA_FIRST_LOGIN_ENDPOINT=
VITE_MANAGEMENT_FA_GOOGLE_CLIENT_ID=

# Interface administrativa local para classificação de primeiro login no FA.
# Mantenha false; isso não ativa o fluxo de autenticação especial.
VITE_MANAGEMENT_FIRST_LOGIN_COHORT_ADMIN_ENABLED=false

# Observação sanitizada das sessões somente no host isolado do piloto.
VITE_MANAGEMENT_AUTH_PILOT_DIAGNOSTICS=false

# Envio por registro para a planilha; vazio mantém desativado. Nunca inserir segredo HMAC aqui.
VITE_OPERATIONAL_SHEETS_ENDPOINT=
