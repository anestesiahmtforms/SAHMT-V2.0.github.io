rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function profile() { return get(profilePath()).data; }
    function activeUser() { return hasProfile() && profile().active == true && profile().access == true; }
    function isAdmin() {
      return activeUser() && ((profile().role == 'administrador_app') ||
        (profile().permissions.keys().hasAny(['admin']) && profile().permissions.admin == true));
    }
    function can(permission) {
      return activeUser() && (isAdmin() ||
        (profile().permissions.keys().hasAny([permission]) && profile().permissions[permission] == true));
    }
    function managementAccess() {
      return can('managementRead') || can('managementManage') || can('managementActivityWrite') ||
        can('managementIndicatorsRead') || can('managementIndicatorsWrite') || can('managementPlansManage');
    }
    function qualityManageArea(areaId) { return can('qualityManage') && areaId == 'area-gestao-da-qualidade'; }
    function activityPointsReviewer(areaId) {
      let areaPath = /databases/$(database)/documents/managementAreas/$(areaId);
      return can('managementManage') || qualityManageArea(areaId) ||
        (can('managementRead') && exists(areaPath) && get(areaPath).data.managerUids is list &&
          get(areaPath).data.managerUids.hasAny([request.auth.uid]));
    }
    function activityAccess(areaId) { return can('managementRead') || can('managementActivityWrite') || qualityManageArea(areaId); }
    function indicatorAccess(areaId) { return can('managementRead') || can('managementIndicatorsRead') || can('managementIndicatorsWrite') || qualityManageArea(areaId); }
    function actionPlanAccess(areaId) { return can('managementRead') || can('managementPlansManage') || qualityManageArea(areaId); }
    function qualityPlanManage(planId) {
      let planPath = /databases/$(database)/documents/actionPlans/$(planId);
      return exists(planPath) && qualityManageArea(get(planPath).data.managementAreaId);
    }
    function activityInteractionCreateAccess(activityId) {
      let activityPath = /databases/$(database)/documents/activities/$(activityId);
      return exists(activityPath) && activityAccess(get(activityPath).data.managementAreaId);
    }
    function notificationManagementAreaAccess(area) {
      return can('notificationsManage') || (can('notificationsRead') && area.active == true &&
        ((area.memberUids is list && area.memberUids.hasAny([request.auth.uid])) ||
         (area.managerUids is list && area.managerUids.hasAny([request.auth.uid]))));
    }
    function notificationAudienceMatches(data) {
      let areaPath = /databases/$(database)/documents/managementAreas/$(data.audienceValue);
      let groupPath = /databases/$(database)/documents/notificationGroups/$(data.audienceValue);
      return (data.audienceType == 'ALL' && data.audienceValue == '') ||
        (data.audienceType == 'USER' && data.audienceValue == request.auth.uid) ||
        (data.audienceType == 'ROLE' && data.audienceValue == profile().role) ||
        (data.audienceType == 'SIGLA' && data.audienceValue == profile().sigla) ||
        (data.audienceType == 'MANAGEMENT_AREA' && exists(areaPath) && get(areaPath).data.active == true &&
          ((get(areaPath).data.memberUids is list && get(areaPath).data.memberUids.hasAny([request.auth.uid])) ||
           (get(areaPath).data.managerUids is list && get(areaPath).data.managerUids.hasAny([request.auth.uid])))) ||
        (data.audienceType == 'GROUP' && exists(groupPath) && get(groupPath).data.active == true &&
          get(groupPath).data.memberUids is list && get(groupPath).data.memberUids.hasAny([request.auth.uid]));
    }
    function validNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'audienceType', 'audienceValue', 'createdAt', 'createdByUid', 'updatedByUid', 'updatedAt', 'startAt', 'endAt', 'active', 'priority', 'actionRoute', 'version']) &&
        data.keys().hasOnly(['id', 'title', 'message', 'type', 'audienceType', 'audienceValue', 'createdAt', 'createdByUid', 'updatedByUid', 'updatedAt', 'startAt', 'endAt', 'active', 'priority', 'actionRoute', 'version']) &&
        data.id == notificationId && data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 1200 && data.type is string && data.type.size() > 0 && data.type.size() <= 40 &&
        data.audienceType in ['ALL', 'ROLE', 'USER', 'SIGLA', 'MANAGEMENT_AREA', 'GROUP'] && data.audienceValue is string && data.audienceValue.size() <= 128 &&
        ((data.audienceType == 'ALL' && data.audienceValue == '') ||
         (data.audienceType == 'ROLE' && data.audienceValue in ['coordenador', 'conselho_diretor', 'gestor', 'anestesiologista', 'residente', 'temporario', 'administrador_app']) ||
         (data.audienceType == 'USER' && data.audienceValue.size() > 0) ||
         (data.audienceType == 'SIGLA' && (data.audienceValue.matches('^[A-Z]{2}$') || data.audienceValue == 'L2')) ||
         (data.audienceType == 'MANAGEMENT_AREA' && activeManagementArea(data.audienceValue)) ||
         (data.audienceType == 'GROUP' && exists(/databases/$(database)/documents/notificationGroups/$(data.audienceValue)) && get(/databases/$(database)/documents/notificationGroups/$(data.audienceValue)).data.active == true)) &&
        data.createdAt is timestamp && data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid && data.updatedAt is timestamp &&
        data.startAt is timestamp && data.endAt is timestamp && data.endAt >= data.startAt && data.active is bool &&
        data.priority is int && data.priority >= 0 && data.priority <= 5 && data.actionRoute in ['', 'home', 'events', 'labels', 'management', 'checklist', 'training', 'people', 'admin'] &&
        data.version is int && data.version > 0;
    }
    function validNotificationRead(data, uid, notificationId) {
      let noticePath = /databases/$(database)/documents/notifications/$(notificationId);
      let notice = get(noticePath).data;
      return data.keys().hasAll(['id', 'notificationId', 'uid', 'readAt']) &&
        data.keys().hasOnly(['id', 'notificationId', 'uid', 'readAt']) &&
        data.id == notificationId && data.notificationId == notificationId && data.uid == uid &&
        data.readAt == request.time && exists(noticePath) && notice.active == true && notificationAudienceMatches(notice);
    }
    function validNotificationGroup(data, groupId) {
      return data.keys().hasAll(['id', 'name', 'memberUids', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'memberUids', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.id == groupId && data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.memberUids is list && data.memberUids.size() <= 500 && data.active is bool &&
        data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function checklistAccess() {
      return can('checklistRead') || can('checklistWrite') || can('checklistSign') || can('checklistManage');
    }
    function validIsoDay(value) {
      return value is string && (
        value.matches('^\\d{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$') ||
        value.matches('^\\d{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$') ||
        value.matches('^\\d{4}-02-(0[1-9]|1[0-9]|2[0-9])$'));
    }
    function validIndicatorPeriod(period, frequency) {
      return (frequency == 'YEARLY' && period.matches('^\\d{4}$')) ||
        (frequency == 'QUARTERLY' && period.matches('^\\d{4}-Q[1-4]$')) ||
        (frequency == 'MONTHLY' && period.matches('^\\d{4}-(0[1-9]|1[0-2])$')) ||
        (frequency == 'WEEKLY' && period.matches('^\\d{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$'));
    }
    function paddedDayPart(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }
    function serverSaoPauloDay() {
      let localTime = request.time - duration.value(3, 'h');
      return string(localTime.year()) + '-' + paddedDayPart(localTime.month()) + '-' + paddedDayPart(localTime.day());
    }
    function stationValidForChecklist(stationId, day) {
      let path = /databases/$(database)/documents/stations/$(stationId);
      let station = get(path).data;
      return stationId is string && stationId.matches('^[^/]{1,128}$') && validIsoDay(day) && exists(path) &&
        station.active == true &&
        (!station.keys().hasAny(['start']) || (validIsoDay(station.start) && station.start <= day)) &&
        (!station.keys().hasAny(['end']) || (validIsoDay(station.end) && station.end >= day)) &&
        (!(station.keys().hasAny(['start']) && station.keys().hasAny(['end'])) || station.start <= station.end);
    }
    function validStation(data, stationId) {
      return data.keys().hasAll(['id', 'name', 'qrCode', 'order', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'version']) &&
        data.keys().hasOnly(['id', 'name', 'qrCode', 'start', 'end', 'order', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'version']) &&
        data.id == stationId && data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.qrCode is string && data.qrCode.size() > 0 && data.qrCode.size() <= 300 &&
        (!data.keys().hasAny(['start']) || validIsoDay(data.start)) &&
        (!data.keys().hasAny(['end']) || validIsoDay(data.end)) &&
        (!(data.keys().hasAny(['start']) && data.keys().hasAny(['end'])) || data.start <= data.end) &&
        data.order is int && data.order >= 0 && data.order <= 9999 && data.active is bool &&
        data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt is timestamp && data.version is int && data.version >= 1;
    }
    function validTraining(data, trainingId) {
      return data.keys().hasAll(['id', 'title', 'description', 'videoId', 'videoUrl', 'accessPoints', 'completionPoints', 'order', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'version']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'videoId', 'videoUrl', 'accessPoints', 'completionPoints', 'order', 'active', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'version']) &&
        data.id == trainingId && data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 500 && data.videoId is string && data.videoId.matches('^[A-Za-z0-9_-]{11}$') &&
        data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 600 &&
        data.accessPoints is number && data.accessPoints >= 0 && data.accessPoints <= 1000 &&
        data.completionPoints is number && data.completionPoints >= 0 && data.completionPoints <= 1000 &&
        data.order is int && data.order >= 0 && data.order <= 9999 && data.active is bool &&
        data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt is timestamp && data.version is int && data.version >= 1;
    }
    function learningActivityAudience(data) {
      return (data.audienceType == 'ALL' && data.audienceValue == '') ||
        (data.audienceType == 'ROLE' && data.audienceValue == profile().role) ||
        (data.audienceType == 'USER' && data.audienceValue == request.auth.uid);
    }
    function learningActivityVisible(data) {
      return (can('trainingsRead') || can('trainingsManage')) && data.status == 'ACTIVE' && data.showInTraining == true && learningActivityAudience(data);
    }
    function validLearningActivity(data, activityId) {
      return data.keys().hasAll(['id', 'version', 'title', 'description', 'category', 'sourceKind', 'resourceUrl', 'showInTraining', 'audienceType', 'audienceValue', 'startAt', 'endAt', 'status', 'completionKind', 'recurrenceMode', 'order', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'version', 'title', 'description', 'category', 'sourceKind', 'resourceUrl', 'showInTraining', 'audienceType', 'audienceValue', 'startAt', 'endAt', 'status', 'completionKind', 'recurrenceMode', 'order', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.id == activityId && activityId.matches('^[A-Za-z0-9_-]{1,64}$') && data.version is int && data.version >= 1 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 && data.description is string && data.description.size() <= 500 &&
        data.category is string && data.category.size() <= 60 && data.sourceKind in ['EXTERNAL_LINK', 'GOOGLE_FORM', 'SHEET', 'DOCUMENT', 'PDF', 'QUIZ', 'SURVEY', 'ACKNOWLEDGEMENT'] &&
        data.resourceUrl is string && data.resourceUrl.size() <= 600 &&
        ((data.sourceKind == 'ACKNOWLEDGEMENT' && data.resourceUrl == '' && data.completionKind == 'ACKNOWLEDGEMENT') ||
         (data.sourceKind == 'EXTERNAL_LINK' && data.resourceUrl.matches('^https://[^ ]+$')) ||
         (data.sourceKind in ['GOOGLE_FORM', 'SHEET', 'DOCUMENT', 'PDF', 'QUIZ', 'SURVEY'] && data.resourceUrl.matches('^https://[^ ]+$') && data.completionKind == 'NONE')) &&
        data.showInTraining is bool && data.audienceType in ['ALL', 'ROLE', 'USER'] && data.audienceValue is string && data.audienceValue.size() <= 128 &&
        ((data.audienceType == 'ALL' && data.audienceValue == '') || (data.audienceType in ['ROLE', 'USER'] && data.audienceValue.size() > 0)) &&
        data.startAt is timestamp && data.endAt is timestamp && data.endAt >= data.startAt &&
        data.status in ['ACTIVE', 'INACTIVE'] && data.completionKind in ['NONE', 'ACKNOWLEDGEMENT'] &&
        data.recurrenceMode in ['ONCE', 'ONCE_PER_VERSION'] && data.order is int && data.order >= 0 && data.order <= 9999 &&
        data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt == request.time;
    }
    function validLearningActivityReceiptForActivity(data, receiptId, activity) {
      let expectedId = data.uid + '_' + data.activityId + (activity.recurrenceMode == 'ONCE' ? '_once' : '_v' + string(activity.version));
      return data.keys().hasAll(['id', 'activityId', 'activityVersion', 'uid', 'evidenceKind', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'activityId', 'activityVersion', 'uid', 'evidenceKind', 'status', 'createdAt']) &&
        data.id == receiptId && receiptId == expectedId && data.uid == request.auth.uid && data.activityVersion is int && data.activityVersion == activity.version && data.evidenceKind == 'ACKNOWLEDGEMENT' && data.status == 'CONFIRMED' &&
        data.createdAt == request.time && (can('trainingsRead') || can('trainingsManage')) && activity.status == 'ACTIVE' && activity.showInTraining == true &&
        activity.completionKind == 'ACKNOWLEDGEMENT' && activity.recurrenceMode in ['ONCE', 'ONCE_PER_VERSION'] &&
        activity.startAt <= request.time && activity.endAt >= request.time && learningActivityAudience(activity);
    }
    function validLearningActivityReceipt(data, receiptId) {
      let activityPath = /databases/$(database)/documents/learningActivities/$(data.activityId);
      return data.keys().hasAll(['id', 'activityId', 'activityVersion', 'uid', 'evidenceKind', 'status', 'createdAt']) &&
        data.activityId is string && data.activityId.matches('^[A-Za-z0-9_-]{1,64}$') && exists(activityPath) &&
        validLearningActivityReceiptForActivity(data, receiptId, get(activityPath).data);
    }
    function validManagementDocument(data, documentId) {
      return data.keys().hasAll(['id', 'managementAreaId', 'title', 'description', 'driveFileId', 'driveUrl', 'version', 'category', 'active', 'publishedAt', 'requiredReading', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'managementAreaId', 'title', 'description', 'driveFileId', 'driveUrl', 'version', 'category', 'active', 'publishedAt', 'requiredReading', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.id == documentId && data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 && data.description is string && data.description.size() <= 1200 &&
        data.driveFileId is string && data.driveFileId.matches('^[A-Za-z0-9_-]{10,200}$') &&
        data.driveUrl == 'https://drive.google.com/file/d/' + data.driveFileId + '/view' &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 && data.active is bool && data.requiredReading is bool &&
        data.publishedAt is timestamp && data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt == request.time && data.version is int && data.version >= 1;
    }
    function validEquipment(data, equipmentId) {
      return data.keys().hasAll(['id', 'tag', 'managementAreaId', 'name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'tag', 'managementAreaId', 'name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.id == equipmentId && data.tag == equipmentId && data.tag.matches('^[A-Z0-9_-]{2,40}$') &&
        data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.serialNumber is string && data.serialNumber.size() <= 120 && data.location is string && data.location.size() > 0 && data.location.size() <= 160 &&
        data.responsibleUid is string && data.responsibleUid.size() > 0 && data.responsibleUid.size() <= 128 &&
        data.status in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] && data.active is bool && (data.status != 'RETIRED' || data.active == false) &&
        (data.lastEventId == null || (data.lastEventId is string && data.lastEventId.size() >= 10 && data.lastEventId.size() <= 200)) &&
        (data.lastEventAt == null || data.lastEventAt is timestamp) && data.version is int && data.version >= 1 &&
        data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt == request.time;
    }
    function validEquipmentEvent(data, eventId) {
      return data.keys().hasAll(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'fromStatus', 'toStatus', 'createdByUid', 'createdAt']) &&
        data.keys().hasOnly(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'fromStatus', 'toStatus', 'createdByUid', 'createdAt']) &&
        data.id == eventId && data.equipmentId is string && data.equipmentId.size() >= 2 && data.equipmentId.size() <= 40 &&
        data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
        data.type in ['INCIDENT', 'STATUS_CHANGE'] && data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
        data.fromStatus in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] && data.toStatus in ['OPERATIONAL', 'MAINTENANCE', 'OUT_OF_SERVICE', 'RETIRED'] &&
        data.createdByUid == request.auth.uid && data.createdAt == request.time;
    }
    function validMaintenanceRecord(data, recordId) {
      return data.keys().hasAll(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'responsibleUid', 'dueAt', 'status', 'completedAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'equipmentId', 'managementAreaId', 'type', 'description', 'responsibleUid', 'dueAt', 'status', 'completedAt', 'version', 'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt']) &&
        data.id == recordId && data.equipmentId is string && data.equipmentId.size() >= 2 && data.equipmentId.size() <= 40 &&
        data.managementAreaId is string && data.managementAreaId.size() > 0 && data.managementAreaId.size() <= 128 &&
        data.type in ['PREVENTIVE', 'CORRECTIVE', 'CALIBRATION', 'INSPECTION'] && data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
        data.responsibleUid is string && data.responsibleUid.size() > 0 && data.responsibleUid.size() <= 128 && (data.dueAt == null || validIsoDay(data.dueAt)) &&
        data.status in ['OPEN', 'IN_PROGRESS', 'COMPLETED'] && (data.completedAt == null || data.completedAt is timestamp) &&
        data.version is int && data.version >= 1 && data.createdByUid == request.auth.uid && data.createdAt is timestamp &&
        data.updatedByUid == request.auth.uid && data.updatedAt == request.time;
    }
    function validEquipmentUpdate(equipmentId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let eventPath = /databases/$(database)/documents/equipmentEvents/$(data.lastEventId);
      return validEquipment(data, equipmentId) && data.managementAreaId == resource.data.managementAreaId &&
        data.createdByUid == resource.data.createdByUid && data.createdAt == resource.data.createdAt && data.version == resource.data.version + 1 &&
        changed.hasOnly(['name', 'category', 'serialNumber', 'location', 'responsibleUid', 'status', 'active', 'lastEventId', 'lastEventAt', 'updatedByUid', 'updatedAt', 'version']) &&
        (!changed.hasAny(['status', 'lastEventId', 'lastEventAt']) ||
          (data.lastEventId is string && data.lastEventAt == request.time && existsAfter(eventPath) &&
           getAfter(eventPath).data.equipmentId == equipmentId && getAfter(eventPath).data.managementAreaId == data.managementAreaId &&
           getAfter(eventPath).data.fromStatus == resource.data.status && getAfter(eventPath).data.toStatus == data.status &&
           getAfter(eventPath).data.createdAt == request.time));
    }
    function validEquipmentEventCreate(eventId) {
      let data = request.resource.data;
      let equipmentPath = /databases/$(database)/documents/equipment/$(data.equipmentId);
      let before = get(equipmentPath).data;
      let after = getAfter(equipmentPath).data;
      return can('equipmentManage') && validEquipmentEvent(data, eventId) && exists(equipmentPath) && existsAfter(equipmentPath) &&
        before.active == true && before.managementAreaId == data.managementAreaId && after.lastEventId == eventId &&
        after.lastEventAt == request.time && after.version == before.version + 1 && after.status == data.toStatus &&
        ((data.type == 'STATUS_CHANGE' && data.toStatus != data.fromStatus) || (data.type == 'INCIDENT' && data.toStatus == data.fromStatus));
    }
    function validMaintenanceTransition(recordId) {
      let data = request.resource.data;
      return validMaintenanceRecord(data, recordId) && data.equipmentId == resource.data.equipmentId &&
        data.managementAreaId == resource.data.managementAreaId && data.type == resource.data.type &&
        data.description == resource.data.description && data.responsibleUid == resource.data.responsibleUid && data.dueAt == resource.data.dueAt &&
        data.createdByUid == resource.data.createdByUid && data.createdAt == resource.data.createdAt && data.version == resource.data.version + 1 &&
        data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedByUid', 'updatedAt', 'version']) &&
        ((resource.data.status == 'OPEN' && data.status == 'IN_PROGRESS' && data.completedAt == null) ||
         (resource.data.status == 'IN_PROGRESS' && data.status == 'COMPLETED' && data.completedAt == request.time));
    }
    function validChecklistRecord(data, checklistId) {
      return data.keys().hasAll(['stationId', 'date', 'condition', 'status', 'occurrence', 'responsibleUid', 'responsibleName', 'responsibleEmail', 'active', 'id', 'clientMutationId', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt', 'version']) &&
        data.keys().hasOnly(['stationId', 'date', 'condition', 'status', 'occurrence', 'responsibleUid', 'responsibleName', 'responsibleEmail', 'active', 'id', 'clientMutationId', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt', 'version']) &&
        data.id == checklistId && data.clientMutationId == checklistId && data.active == true && data.version == 1 &&
        data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid &&
        data.createdAt == request.time && data.updatedAt == request.time &&
        data.stationId is string && stationValidForChecklist(data.stationId, data.date) &&
        validIsoDay(data.date) && data.date == serverSaoPauloDay() && data.condition in ['SIM', 'NAO'] &&
        ((data.condition == 'SIM' && data.status == 'COMPLETED' && data.occurrence == '') ||
         (data.condition == 'NAO' && data.status == 'MAINTENANCE' && data.occurrence is string && data.occurrence.size() > 0 && data.occurrence.size() <= 500)) &&
        data.responsibleUid == null && data.responsibleName == null && data.responsibleEmail == null;
    }
    function validChecklistSignatureRequest(data, requestId) {
      return data.keys().hasAll(['id', 'day', 'revision', 'signerUid', 'declaration', 'justification', 'status', 'requestedAt']) &&
