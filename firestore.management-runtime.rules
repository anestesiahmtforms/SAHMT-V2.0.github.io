rules_version = '2';

// FB preparation only. Not referenced by firebase.json and not published.
// The broker adapter owns this NEW projection; no browser may write it.
service cloud.firestore {
  match /databases/{database}/documents {
    function identifier(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum &&
        value.matches('^[^/[:space:][:cntrl:]]+$');
    }
    function customManagementIdentity() {
      return request.auth != null && identifier(request.auth.uid, 128) &&
        request.auth.token.keys().hasAll([
          'firebase', 'managementSourceProjectId', 'managementMemberId',
          'managementSourceVersion', 'managementSourceHash',
          'managementPolicyVersion', 'managementSourceAuthTimeMs'
        ]) && request.auth.token.firebase is map && request.auth.token.firebase.keys().hasAll(['sign_in_provider']) &&
        request.auth.token.firebase.sign_in_provider == 'custom' &&
        request.auth.token.managementSourceProjectId == 'sahmt-17a16' &&
        identifier(request.auth.token.managementMemberId, 200) &&
        request.auth.token.managementSourceVersion is int &&
        request.auth.token.managementSourceVersion > 0 && request.auth.token.managementSourceVersion <= 9007199254740991 &&
        request.auth.token.managementSourceHash is string &&
        request.auth.token.managementSourceHash.matches('^[a-f0-9]{64}$') &&
        identifier(request.auth.token.managementPolicyVersion, 100) &&
        request.auth.token.managementSourceAuthTimeMs is int &&
        request.auth.token.managementSourceAuthTimeMs > 0 && request.auth.token.managementSourceAuthTimeMs <= 9007199254740991;
    }
    function leaseFields(data) {
      return data is map && data.keys().hasAll([
        'schemaVersion', 'sourceProjectId', 'destinationProjectId',
        'faUid', 'fbUid', 'memberId', 'leaseVersion', 'grantId',
        'sourceVersion', 'policyVersion', 'sourceHash', 'active', 'revoked',
        'managementAllowed', 'role', 'permissions', 'memberAreaIds',
        'managerAreaIds', 'documentGroups', 'sourceAuthValidAfterTimeMs',
        'confirmedAtMs', 'validUntilMs'
      ]) && data.keys().hasOnly([
        'schemaVersion', 'sourceProjectId', 'destinationProjectId',
        'faUid', 'fbUid', 'memberId', 'leaseVersion', 'grantId',
        'sourceVersion', 'policyVersion', 'sourceHash', 'active', 'revoked',
        'managementAllowed', 'role', 'permissions', 'memberAreaIds',
        'managerAreaIds', 'documentGroups', 'sourceAuthValidAfterTimeMs',
        'confirmedAtMs', 'validUntilMs'
      ]);
    }
    function permissionShape(data) {
      return data.permissions is map &&
        data.permissions.keys().hasAll([
          'admin', 'managementRead', 'managementManage', 'managementActivityWrite',
          'managementIndicatorsRead', 'managementIndicatorsWrite', 'managementPlansManage',
          'documentsManage', 'equipmentManage', 'qualityManage', 'trainingsRead', 'trainingsManage',
          'financeRead', 'financeWrite', 'financeManage'
        ]) && data.permissions.keys().hasOnly([
          'admin', 'managementRead', 'managementManage', 'managementActivityWrite',
          'managementIndicatorsRead', 'managementIndicatorsWrite', 'managementPlansManage',
          'documentsManage', 'equipmentManage', 'qualityManage', 'trainingsRead', 'trainingsManage',
          'financeRead', 'financeWrite', 'financeManage'
        ]) &&
        data.permissions.admin is bool && data.permissions.managementRead is bool &&
        data.permissions.managementManage is bool && data.permissions.managementActivityWrite is bool &&
        data.permissions.managementIndicatorsRead is bool && data.permissions.managementIndicatorsWrite is bool &&
        data.permissions.managementPlansManage is bool && data.permissions.documentsManage is bool &&
        data.permissions.equipmentManage is bool && data.permissions.qualityManage is bool &&
        data.permissions.trainingsRead is bool && data.permissions.trainingsManage is bool && data.permissions.financeRead is bool &&
        data.permissions.financeWrite is bool && data.permissions.financeManage is bool;
    }
    function validManagementLease(data) {
      return leaseFields(data) && data.schemaVersion is int && data.schemaVersion == 1 &&
        data.sourceProjectId == 'sahmt-17a16' &&
        data.destinationProjectId == 'sahmt-gestao-5ae66' &&
        data.faUid == request.auth.uid && data.fbUid == request.auth.uid &&
        data.memberId == request.auth.token.managementMemberId &&
        identifier(data.memberId, 200) && data.leaseVersion is int && data.leaseVersion > 0 && data.leaseVersion <= 9007199254740991 &&
        identifier(data.grantId, 100) &&
        data.sourceVersion is int && data.sourceVersion == request.auth.token.managementSourceVersion &&
        data.sourceHash == request.auth.token.managementSourceHash &&
        data.policyVersion == request.auth.token.managementPolicyVersion &&
        data.active == true && data.revoked == false && data.managementAllowed == true &&
        data.role is string && data.role.size() <= 100 && permissionShape(data) &&
        data.memberAreaIds is list && data.memberAreaIds.size() <= 1000 &&
        data.memberAreaIds.toSet().size() == data.memberAreaIds.size() &&
        data.managerAreaIds is list && data.managerAreaIds.size() <= 1000 &&
        data.managerAreaIds.toSet().size() == data.managerAreaIds.size() &&
        data.documentGroups is list && data.documentGroups.size() <= 2 &&
        data.documentGroups.hasOnly(['GENERAL', 'RESTRICTED']) &&
        data.documentGroups.toSet().size() == data.documentGroups.size() &&
        data.sourceAuthValidAfterTimeMs is int && data.sourceAuthValidAfterTimeMs >= 0 && data.sourceAuthValidAfterTimeMs <= 9007199254740991 &&
        request.auth.token.managementSourceAuthTimeMs >= data.sourceAuthValidAfterTimeMs &&
        data.confirmedAtMs is int && data.confirmedAtMs > 0 && data.confirmedAtMs <= 9007199254740991 &&
        request.auth.token.managementSourceAuthTimeMs <= data.confirmedAtMs &&
        data.confirmedAtMs <= request.time.toMillis() &&
        data.validUntilMs is int && data.validUntilMs > data.confirmedAtMs && data.validUntilMs <= 9007199254740991 &&
        request.time.toMillis() < data.validUntilMs;
    }

    function validTrainingReadLease() {
      let leasePath = /databases/$(database)/documents/managementAuthorizationLeases/$(request.auth.uid);
      return database == '(default)' && customManagementIdentity() && exists(leasePath) &&
        validManagementLease(get(leasePath).data) &&
        (get(leasePath).data.permissions.trainingsRead == true ||
          get(leasePath).data.permissions.trainingsManage == true);
    }

    match /managementAuthorizationLeases/{uid} {
      // resource is the requested lease: no extra get()/exists() access call.
      // Absence, expiration or revocation denies the read; do not bootstrap it.
      allow get: if database == '(default)' && customManagementIdentity() &&
        uid == request.auth.uid && resource != null && validManagementLease(resource.data);
      allow list, create, update, delete: if false;
    }

    // Read-only pilot path. Broker-minted FB sessions must have a current,
    // matching FA authorization lease; collection scans must be capped at one.
    match /trainings/{trainingId} {
      allow get: if false;
      allow list: if validTrainingReadLease() && request.query.limit != null && request.query.limit <= 1;
      allow create, update, delete: if false;
    }

    // Explicit domain cutover, server-owned and disabled when absent.
    function evaluationRuntimeEnabled() {
      let p = /databases/$(database)/documents/managementRuntime/domainCutover;
      return exists(p) && get(p).data.schemaVersion == 1 &&
        get(p).data.projectId == 'sahmt-gestao-5ae66' && get(p).data.evaluationEnabled == true;
    }
    function profile() { return get(/databases/$(database)/documents/managementAuthorizationLeases/$(request.auth.uid)).data; }
    // Server-owned projection: validate the binding, revocation and time boundary
    // once per operation. Shape validation remains at the trusted writer.
    function activeUser() {
      let lease = profile();
      let token = request.auth.token;
      return database == '(default)' && request.auth != null && token.firebase.sign_in_provider == 'custom' &&
        token.managementSourceProjectId == 'sahmt-17a16' && lease.schemaVersion == 1 &&
        lease.sourceProjectId == 'sahmt-17a16' && lease.destinationProjectId == 'sahmt-gestao-5ae66' &&
        lease.faUid == request.auth.uid && lease.fbUid == request.auth.uid &&
        lease.memberId == token.managementMemberId && lease.sourceVersion == token.managementSourceVersion &&
        lease.sourceHash == token.managementSourceHash && lease.policyVersion == token.managementPolicyVersion &&
        lease.active == true && lease.revoked == false && lease.managementAllowed == true &&
        token.managementSourceAuthTimeMs >= lease.sourceAuthValidAfterTimeMs &&
        token.managementSourceAuthTimeMs <= lease.confirmedAtMs && lease.confirmedAtMs <= request.time.toMillis() &&
        request.time.toMillis() < lease.validUntilMs && evaluationRuntimeEnabled() &&
        (lease.permissions.managementRead == true || lease.permissions.managementManage == true ||
          lease.permissions.trainingsRead == true || lease.permissions.trainingsManage == true);
    }
    function isAdmin() {
      return profile().permissions.managementManage &&
        (profile().permissions.admin || profile().role == 'administrador_app');
    }
    // These predicates are only called behind activeUser at each allow entry.
    function can(permission) { return isAdmin() || profile().permissions[permission] == true; }

    function evaluationOwn(data) { return activeUser() && (isAdmin() || data.uid == request.auth.uid); }

    match /evaluationActivities/{id} {
      function evaluationGroupAccess(group) {
        return profile().documentGroups.hasAny([group]);
      }
      function evaluationGroupEligible(data) {
        return (evaluationGroupAccess('GENERAL') && 'GENERAL' in data.eligibleGroups) ||
          (evaluationGroupAccess('RESTRICTED') && 'RESTRICTED' in data.eligibleGroups);
      }

      allow read: if activeUser() && (isAdmin() || evaluationGroupEligible(resource.data) ||
        request.auth.uid in resource.data.eligibleUids || resource.data.managerUid == request.auth.uid);
      allow write: if false;
    }
    match /evaluationAwards/{id} { allow read: if evaluationOwn(resource.data); allow write: if false; }
    match /evaluationLedger/{id} { allow read: if evaluationOwn(resource.data); allow write: if false; }
    match /evaluationSummaries/{uid} { allow read: if activeUser() && (request.auth.uid == uid || isAdmin()); allow write: if false; }
    match /evaluationReference/{id} { allow read: if activeUser() && id == 'team'; allow write: if false; }
    match /evaluationAssignments/{id} { allow read: if evaluationOwn(resource.data); allow write: if false; }
    match /evaluationAssignmentHistory/{id} { allow read: if activeUser() && isAdmin(); allow write: if false; }
    match /evaluationGovernanceRevisions/{id} { allow read: if evaluationOwn(resource.data); allow write: if false; }
    match /evaluationParticipations/{id} { allow read: if activeUser() && (resource.data.uid == request.auth.uid || isAdmin() || resource.data.managerUid == request.auth.uid || can('managementManage') || (can('qualityManage') && resource.data.areaIds.hasAny(['area-gestao-da-qualidade']))); allow write: if false; }
    match /evaluationLinks/{id} { allow read: if activeUser() && isAdmin(); allow write: if false; }
    match /evaluationRequests/{id} {
      function evaluationId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,200}$'); }
      function evaluationText(value, minimum, maximum) { return value is string && value.size() >= minimum && value.size() <= maximum; }
      function evaluationHttpsAt(values, index) { return values.size() <= index || (values[index] is string && values[index].size() <= 1500 && values[index].matches('^https://[^/@: ]+[/].*')); }
      function evaluationEvidence(values) {
        return values is list && values.size() <= 10 && evaluationHttpsAt(values, 0) && evaluationHttpsAt(values, 1) &&
          evaluationHttpsAt(values, 2) && evaluationHttpsAt(values, 3) && evaluationHttpsAt(values, 4) && evaluationHttpsAt(values, 5) &&
          evaluationHttpsAt(values, 6) && evaluationHttpsAt(values, 7) && evaluationHttpsAt(values, 8) && evaluationHttpsAt(values, 9);
      }
      function evaluationConfiguration(p) {
        return p.keys().hasAll(['activityId', 'creditScopeId', 'version', 'modalities', 'acknowledgementItemId', 'suggestionProblemItemId', 'suggestionProposalItemId', 'suggestionBenefitItemId', 'validFrom', 'validUntil', 'eligibleUids', 'managerAreaId', 'expectedVersion']) &&
          p.keys().hasOnly(['activityId', 'creditScopeId', 'version', 'modalities', 'acknowledgementItemId', 'suggestionProblemItemId', 'suggestionProposalItemId', 'suggestionBenefitItemId', 'validFrom', 'validUntil', 'eligibleUids', 'eligibleGroups', 'managerAreaId', 'expectedVersion', 'acknowledgementValue', 'materialUrls']) &&
          evaluationId(p.activityId) && evaluationId(p.creditScopeId) && evaluationId(p.managerAreaId) &&
          p.version is int && p.version > 0 && p.expectedVersion is int && p.expectedVersion >= 0 &&
          p.modalities is map && p.modalities.keys().hasAll(['acknowledgement', 'suggestion', 'test']) && p.modalities.keys().hasOnly(['acknowledgement', 'suggestion', 'test']) &&
          p.modalities.acknowledgement is bool && p.modalities.suggestion is bool && p.modalities.test is bool &&
          (p.modalities.acknowledgement || p.modalities.suggestion || p.modalities.test) &&
          evaluationText(p.acknowledgementItemId, 0, 200) && evaluationText(p.suggestionProblemItemId, 0, 200) && evaluationText(p.suggestionProposalItemId, 0, 200) && evaluationText(p.suggestionBenefitItemId, 0, 200) &&
          p.validFrom is string && p.validFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && p.validUntil is string && p.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && p.validFrom <= p.validUntil &&
          p.eligibleUids is list && p.eligibleUids.size() <= 500 &&
          (!p.keys().hasAny(['eligibleGroups']) || (p.eligibleGroups is list && p.eligibleGroups.size() <= 2 && p.eligibleGroups.toSet().size() == p.eligibleGroups.size() && p.eligibleGroups.hasOnly(['GENERAL', 'RESTRICTED']))) &&
          (p.eligibleUids.size() > 0 || (p.keys().hasAny(['eligibleGroups']) && p.eligibleGroups.size() > 0)) &&
          (!p.keys().hasAny(['acknowledgementValue']) || evaluationText(p.acknowledgementValue, 1, 200)) &&
          (!p.keys().hasAny(['materialUrls']) || evaluationEvidence(p.materialUrls));
      }
      function evaluationGovernanceRequest(p) {
        let assignmentPath = /databases/$(database)/documents/evaluationAssignments/$(p.areaId);
        return p.keys().hasAll(['activityId', 'areaId', 'assignmentId', 'previousVersion', 'newVersion', 'summary', 'components', 'materialEvidence', 'questionEvidence']) &&
          p.keys().hasOnly(['activityId', 'areaId', 'assignmentId', 'previousVersion', 'newVersion', 'summary', 'components', 'materialEvidence', 'questionEvidence']) &&
          evaluationId(p.activityId) && evaluationId(p.areaId) && evaluationId(p.assignmentId) &&
          exists(assignmentPath) && get(assignmentPath).data.uid == request.auth.uid &&
          p.previousVersion is int && p.previousVersion >= 0 && p.newVersion is int && p.newVersion > p.previousVersion &&
          evaluationText(p.summary, 8, 2000) && p.components is list && p.components.size() >= 1 && p.components.size() <= 2 && p.components.toSet().size() == p.components.size() && p.components.hasOnly(['MATERIAL', 'QUESTIONS']) &&
          evaluationEvidence(p.materialEvidence) && evaluationEvidence(p.questionEvidence) &&
          (!p.components.hasAny(['MATERIAL']) || p.materialEvidence.size() > 0) && (!p.components.hasAny(['QUESTIONS']) || p.questionEvidence.size() > 0);
      }
      function evaluationSuggestionReview(p) {
        let path = /databases/$(database)/documents/evaluationParticipations/$(p.participationId);
        let authorizedReviewer = isAdmin() || can('managementManage') ||
          (can('qualityManage') && get(path).data.areaIds.hasAny(['area-gestao-da-qualidade'])) ||
          get(path).data.managerUid == request.auth.uid;
        return p.keys().hasAll(['participationId', 'decision', 'note']) && p.keys().hasOnly(['participationId', 'decision', 'note']) &&
          evaluationId(p.participationId) && p.decision in ['APPROVE', 'REJECT'] && evaluationText(p.note, 8, 1000) &&
          exists(path) && get(path).data.uid != request.auth.uid && authorizedReviewer;
      }
      function evaluationGovernanceReview(p) {
        let path = /databases/$(database)/documents/evaluationGovernanceRevisions/$(p.revisionId);
        return isAdmin() && p.keys().hasAll(['revisionId', 'decision', 'note']) && p.keys().hasOnly(['revisionId', 'decision', 'note']) &&
          evaluationId(p.revisionId) && p.decision in ['APPROVE', 'REJECT'] && evaluationText(p.note, 8, 1000) && exists(path) && get(path).data.uid != request.auth.uid;
      }
      function evaluationCorrection(p) {
        let path = /databases/$(database)/documents/evaluationAwards/$(p.awardId);
        return isAdmin() && p.keys().hasAll(['awardId', 'category', 'expectedAwardVersion', 'correctedPoints', 'reason']) &&
          p.keys().hasOnly(['awardId', 'category', 'expectedAwardVersion', 'correctedPoints', 'reason']) && evaluationId(p.awardId) &&
          p.category in ['PERFORMANCE', 'GOVERNANCE'] && exists(path) && get(path).data.category == p.category &&
          p.expectedAwardVersion is int && p.expectedAwardVersion >= 0 && p.correctedPoints is number && p.correctedPoints >= -100000 && p.correctedPoints <= 100000 && evaluationText(p.reason, 8, 1000);
      }
      function validEvaluationRequest(data, id) {
        // The validated lease attests the verified FA identity, including UID-only FB users.
        return activeUser() &&
          data.keys().hasAll(['id', 'type', 'actorUid', 'createdAt', 'status', 'payload']) && data.keys().hasOnly(['id', 'type', 'actorUid', 'createdAt', 'status', 'payload']) &&
          data.id == id && evaluationId(id) && data.actorUid == request.auth.uid && data.createdAt == request.time && data.status == 'PENDING' && data.payload is map &&
          ((data.type == 'ASSIGN_MANAGER' && isAdmin() && data.payload.keys().hasAll(['areaId', 'managerUid', 'expectedVersion']) && data.payload.keys().hasOnly(['areaId', 'managerUid', 'expectedVersion']) && evaluationId(data.payload.areaId) && evaluationId(data.payload.managerUid) && data.payload.expectedVersion is int && data.payload.expectedVersion >= 0) ||
           (data.type == 'CONFIGURE_ACTIVITY' && isAdmin() && evaluationConfiguration(data.payload)) ||
           (data.type == 'REQUEST_GOVERNANCE' && evaluationGovernanceRequest(data.payload)) ||
           (data.type == 'REVIEW_SUGGESTION' && evaluationSuggestionReview(data.payload)) ||
           (data.type == 'REVIEW_GOVERNANCE' && evaluationGovernanceReview(data.payload)) ||
           (data.type == 'CORRECT_SCORE' && evaluationCorrection(data.payload)) ||
           (data.type == 'RECONCILE_LINKS' && (isAdmin() || can('documentsManage') || can('managementManage') || can('qualityManage') || can('trainingsManage')) && data.payload.keys().size() == 0));
      }

      allow get: if activeUser() && (resource == null || isAdmin() || resource.data.actorUid == request.auth.uid);
      allow list: if activeUser() && (isAdmin() || resource.data.actorUid == request.auth.uid);
      allow create: if validEvaluationRequest(request.resource.data, id);
      allow update, delete: if false;
    }
    // Resource scopes/schemas and the FA -> FB authorization reconciliation are
    // not approved/implemented yet. A valid entry lease does not grant resources.
    // This also blocks descendants, mirrors, ledger, provenance and migration.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
